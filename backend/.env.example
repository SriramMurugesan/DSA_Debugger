# ==============================================================================
# MagizhCode Backend Environment Configuration
# ==============================================================================

# Server Environment ('development' or 'production')
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Database
# SQLite (Local Dev): sqlite:///./magizhcode.db
# PostgreSQL (Production): postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./magizhcode.db

# Security & Session Secrets
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-secret-key
SESSION_COOKIE_NAME=magizhcode_session
SESSION_MAX_AGE_SECONDS=86400

# Session Cookie Security for Deployment:
# - Set SESSION_COOKIE_SECURE=true when serving over HTTPS
# - Set SESSION_COOKIE_SAMESITE=none if frontend and backend are on different domains
# - Set SESSION_COOKIE_SAMESITE=lax if frontend and backend share the same domain/subdomain
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=.yourdomain.com

# Frontend & CORS Configuration
# The primary URL of your frontend application:
FRONTEND_URL=http://localhost:5173

# Comma-separated list of additional allowed frontend origins for CORS:
# Example: https://magizhcode.vercel.app,https://my-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OAuth Credentials: Google
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# OAuth Credentials: GitHub
# Obtain from GitHub -> Settings -> Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
