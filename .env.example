# ==============================================================================
# MagizhCode - Root Environment Variables Example
# ==============================================================================
# Note: In monorepo / multi-service deployments, you can configure environments
# either at root (for docker-compose) or separately inside backend/ and frontend/.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Database
# Local SQLite: sqlite:///./magizhcode.db
# Cloud PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./magizhcode.db

# Security & Sessions
SECRET_KEY=change-this-to-a-long-random-secret-key
SESSION_COOKIE_NAME=magizhcode_session
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=.yourdomain.com

# CORS & Frontend Origin
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite / React)
# ------------------------------------------------------------------------------
# Vite client-side variables MUST begin with VITE_
VITE_API_URL=http://localhost:8000/api/v1
VITE_ENABLE_DEV_LOGIN=true
