# ==============================================================================
# MagizhCode Frontend Environment Configuration
# ==============================================================================

# Backend API base URL (must include /api/v1 prefix, no trailing slash)
# Local Dev: http://localhost:8000/api/v1
# Production: https://api.yourdomain.com/api/v1 or https://magizhcode-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Testing & Dev Options:
# Enable "Dev Login (Test Mode)" button on the Landing Page to bypass OAuth during testing
# Set to 'false' in production if you want strictly real Google/GitHub logins
VITE_ENABLE_DEV_LOGIN=true
